{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FounderCompoundOutputs",
  "type": "object",
  "required": ["learningPath", "track", "learningType", "confidence", "recommendedNext"],
  "properties": {
    "learningPath": { "type": "string" },
    "track": { "type": "string" },
    "learningType": { "type": "string" },
    "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
    "recommendedNext": { "type": "string" },
    "updatedFiles": { "type": "array", "items": { "type": "string" } }
  }
}
